<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/surface_dark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/background_warm</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <style name="ChildCredentialTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/surface_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/background_warm</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <!-- Buttons -->
    <style name="OkButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CancelButton">
        <item name="android:textAlignment">center</item>
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
    </style>

    <!-- Text Styles -->
    <style name="HeaderText">
        <item name="android:textStyle">bold</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/text_size_24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_margin">@dimen/margin_8dp</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
    </style>

    <style name="BodyText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_margin">@dimen/margin_8dp</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

    <!-- Input Style -->
    <style name="MainEditText">
        <item name="android:maxLines">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">@dimen/margin_8dp</item>
        <item name="android:layout_marginBottom">@dimen/margin_8dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:drawablePadding">@dimen/padding_12dp</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

    <!--Permissions styles-->
    <style name="TextViewPermissions">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

    <style name="TextViewPermissionsExplanation">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_marginTop">@dimen/margin_24dp</item>
        <item name="android:layout_marginBottom">@dimen/margin_24dp</item>
        <item name="android:layout_marginStart">@dimen/margin_24dp</item>
        <item name="android:layout_marginEnd">@dimen/margin_24dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="ButtonPermissionsNext">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_gravity">end|center</item>
        <item name="android:background">@drawable/bg_nav_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ButtonPermissionsPrev">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_gravity">start|center</item>
        <item name="android:background">@drawable/bg_nav_button_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <!--End of permissions styles-->

    <!--Dialog fragments styles-->
    <style name="DialogFragmentImage">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/dialog_fragment_round_icon_background</item>
        <item name="android:padding">1dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:layout_gravity">center_horizontal|top</item>
    </style>

    <style name="DialogFragmentBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginStart">@dimen/margin_32dp</item>
        <item name="android:layout_marginEnd">@dimen/margin_32dp</item>
        <item name="android:layout_marginTop">@dimen/margin_24dp</item>
        <item name="android:layout_marginBottom">@dimen/margin_16dp</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

    <style name="DialogFragmentEditText">
        <item name="android:maxLines">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">@dimen/margin_32dp</item>
        <item name="android:layout_marginEnd">@dimen/margin_32dp</item>
        <item name="android:layout_marginTop">@dimen/margin_24dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:drawablePadding">@dimen/padding_8dp</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

    <style name="DialogFragmentButtonOk">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:text">@string/ok</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
    </style>

    <style name="DialogFragmentButtonCancel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:text">@string/cancel</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>
    <!--End of dialog fragments styles-->

    <!--Cards styles-->
    <style name="CardHeader">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:layout_margin">@dimen/margin_4dp</item>
        <item name="android:gravity">start|center</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
    </style>

    <style name="CardBody">
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/margin_4dp</item>
        <item name="android:gravity">start|center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

    <style name="CardSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center|end</item>
        <item name="android:layout_margin">@dimen/margin_4dp</item>
    </style>

    <style name="CardTextBackground">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_gradient_header</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
    </style>
    <!--End of cards styles-->

    <style name="TextViewNoElements">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:visibility">gone</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

    <!--Settings styles-->
    <style name="TextViewSettingsHeader">
        <item name="android:textSize">@dimen/text_size_18sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_32dp</item>
        <item name="android:layout_marginBottom">@dimen/margin_8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
    </style>

    <style name="ButtonSettings">
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/padding_32dp</item>
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
    </style>

</resources>
