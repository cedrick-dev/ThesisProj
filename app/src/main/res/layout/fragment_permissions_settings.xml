<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <!-- Top Gradient Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_header_curved">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <!-- Icon with circle backdrop -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal">

                <View
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_permission_icon_circle" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_permissions_settings"
                    android:contentDescription="@string/permission_explanation_settings" />
            </FrameLayout>

            <!-- Step Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Step 2 of 3"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans_regular"
                android:letterSpacing="0.08" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Device Control"
                android:textColor="@color/text_on_dark"
                android:textSize="24sp"
                android:fontFamily="@font/open_sans_bold" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Explanation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_explanation_settings"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAlignment="center"
            android:fontFamily="@font/open_sans_regular"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />

        <!-- Permission Rows Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_permission_row"
            android:orientation="vertical"
            android:padding="4dp">

            <!-- Overlay Permission -->
            <LinearLayout
                android:id="@+id/layoutSecondPermission"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/overlay_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <Switch
                    android:id="@+id/switchOverlayPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider" />

            <!-- Package Usage Permission -->
            <LinearLayout
                android:id="@+id/layoutThirdPermission"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/package_usage_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <Switch
                    android:id="@+id/switchPackageUsagePermission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider" />

            <!-- Device Admin Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/device_admin_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <Switch
                    android:id="@+id/switchDeviceAdminPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Navigation Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <Button
                android:id="@+id/btnPermissionsSettingsPrev"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_nav_button_secondary"
                android:text="@string/back"
                android:textColor="@color/text_secondary"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:fontFamily="@font/open_sans_regular"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null" />

            <!-- Step Dots -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_dot" />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_dot_selected" />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_dot" />
            </LinearLayout>

            <!-- Finish Button -->
            <Button
                android:id="@+id/btnPermissionsSettingsNext"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_nav_button_primary"
                android:text="@string/next"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:fontFamily="@font/open_sans_bold"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:elevation="2dp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>