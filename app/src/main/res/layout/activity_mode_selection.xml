<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <!-- Dark Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height_small"
        android:background="@drawable/bg_gradient_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_32dp"
            android:paddingEnd="@dimen/margin_32dp">

            <!-- App Name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kid"
                    android:textColor="@color/text_on_dark"
                    android:textSize="@dimen/text_size_28sp"
                    android:fontFamily="@font/open_sans_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safe"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_28sp"
                    android:fontFamily="@font/open_sans_extra_bold"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_12dp"
                android:text="@string/choose_your_role"
                android:textColor="@color/text_on_dark"
                android:textSize="@dimen/text_size_22sp"
                android:fontFamily="@font/open_sans_bold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:text="@string/who_uses_device_subtitle"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="@dimen/text_size_14sp"
                android:fontFamily="@font/open_sans_regular" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Cards Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/margin_24dp"
        android:paddingEnd="@dimen/margin_24dp"
        android:paddingBottom="@dimen/margin_48dp">

        <!-- Parent Card -->
        <LinearLayout
            android:id="@+id/imgParentSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mode_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_24dp"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="@dimen/mode_card_icon_size"
                android:layout_height="@dimen/mode_card_icon_size"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_parents"
                app:civ_border_color="@color/colorPrimary"
                app:civ_border_width="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_16dp">

                <TextView
                    android:id="@+id/txtParentSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/parent"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_18sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:text="@string/parent_role_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />
            </LinearLayout>

            <!-- Arrow indicator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_28sp" />

        </LinearLayout>

        <!-- Child Card -->
        <LinearLayout
            android:id="@+id/imgChildSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mode_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_24dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="@dimen/mode_card_icon_size"
                android:layout_height="@dimen/mode_card_icon_size"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_children"
                app:civ_border_color="@color/colorPrimary"
                app:civ_border_width="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_16dp">

                <TextView
                    android:id="@+id/txtChildSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/child"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_18sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:text="@string/child_role_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />
            </LinearLayout>

            <!-- Arrow indicator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_28sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>