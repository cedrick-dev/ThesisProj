<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    android:focusableInTouchMode="true"
    android:layoutDirection="locale"
    android:orientation="vertical"
    tools:context=".activities.LoginActivity">

    <!-- Dark Gradient Header Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_gradient_header">

        <!-- Inner content centered -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_32dp"
            android:paddingEnd="@dimen/margin_32dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="@dimen/logo_size_large"
                android:layout_height="@dimen/logo_size_large"
                android:src="@drawable/aegistnetlogo"
                android:contentDescription="@string/app_name" />

            <!-- App Name (Two-tone) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kid"
                    android:textColor="@color/text_on_dark"
                    android:textSize="@dimen/text_size_32sp"
                    android:fontFamily="@font/open_sans_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safe"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_32sp"
                    android:fontFamily="@font/open_sans_extra_bold"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8dp"
                android:text="@string/tagline"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="@dimen/text_size_14sp"
                android:fontFamily="@font/open_sans_regular"
                android:letterSpacing="0.05" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Card Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/margin_24dp"
        android:paddingEnd="@dimen/margin_24dp"
        android:paddingTop="@dimen/margin_32dp"
        android:paddingBottom="@dimen/margin_48dp">

        <!-- Shield icon -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:src="@drawable/ic_shield_check"
            android:contentDescription="@string/child" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/child_device_setup_desc"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_14sp"
            android:textAlignment="center"
            android:fontFamily="@font/open_sans_regular"
            android:layout_marginBottom="@dimen/margin_24dp" />

        <!-- QR Scan Button -->
        <Button
            android:id="@+id/btnChildQrLogin"
            style="@style/OkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_qr_scan"
            android:drawablePadding="@dimen/padding_12dp"
            android:text="@string/scan_qr_code" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>