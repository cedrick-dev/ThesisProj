<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    android:focusableInTouchMode="true"
    android:layoutDirection="locale"
    android:orientation="vertical"
    tools:context=".activities.LoginActivity">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/margin_32dp">

            <!-- Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/margin_32dp"
                android:paddingBottom="@dimen/margin_32dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:src="@drawable/aegistnetlogo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kid"
                        android:textColor="@color/text_on_dark"
                        android:textSize="@dimen/text_size_28sp"
                        android:fontFamily="@font/open_sans_regular" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/safe"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_size_28sp"
                        android:fontFamily="@font/open_sans_extra_bold"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version"
                        android:textColor="@color/text_on_dark_secondary"
                        android:textSize="@dimen/text_size_14sp"
                        android:fontFamily="@font/open_sans_regular" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" "
                        android:textSize="@dimen/text_size_14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_1_0"
                        android:textColor="@color/text_on_dark_secondary"
                        android:textSize="@dimen/text_size_14sp"
                        android:fontFamily="@font/open_sans_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- About Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_card"
                android:orientation="vertical"
                android:padding="@dimen/padding_24dp"
                android:layout_marginTop="@dimen/margin_12dp"
                android:layout_marginBottom="@dimen/margin_12dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <!-- Team Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_card"
                android:orientation="vertical"
                android:padding="@dimen/padding_24dp"
                android:layout_marginBottom="@dimen/margin_12dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_12dp"
                    android:text="@string/developers"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_16sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/developer1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/developer2"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/developer3"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/developer4"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8dp"
                    android:text="@string/thesis_adviser"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_16sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adviser_name"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8dp"
                    android:text="@string/technical_critic"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_16sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/critic_name"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/critic_name2"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14sp"
                    android:fontFamily="@font/open_sans_regular" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
