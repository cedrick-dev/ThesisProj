<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    android:focusableInTouchMode="true"
    android:gravity="top|center_horizontal"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <!-- Dark Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height_small"
        android:background="@drawable/bg_gradient_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_32dp"
            android:paddingEnd="@dimen/margin_32dp">

            <!-- App Name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kid"
                    android:textColor="@color/text_on_dark"
                    android:textSize="@dimen/text_size_28sp"
                    android:fontFamily="@font/open_sans_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safe"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_28sp"
                    android:fontFamily="@font/open_sans_extra_bold"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_12dp"
                android:text="Child Device Setup"
                android:textColor="@color/text_on_dark"
                android:textSize="@dimen/text_size_22sp"
                android:fontFamily="@font/open_sans_bold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:text="Connect this device to the following parent:"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="@dimen/text_size_14sp"
                android:fontFamily="@font/open_sans_regular" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Form Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_24dp"
            android:paddingEnd="@dimen/margin_24dp"
            android:paddingTop="@dimen/margin_24dp"
            android:paddingBottom="@dimen/margin_32dp">

            <!-- Card container for form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_elevated"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="@dimen/padding_24dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Parent Email"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtParentEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:textColor="@color/text_secondary"
                        android:inputType="textEmailAddress"
                        android:fontFamily="@font/open_sans_regular" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Child's Name"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtChildName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/open_sans_regular" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Child's Age"
                    android:layout_marginBottom="@dimen/margin_16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtChildAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="number"
                        android:fontFamily="@font/open_sans_regular" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sex"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_16sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="@dimen/margin_8dp" />

                <RadioGroup
                    android:id="@+id/rgGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_8dp">

                    <RadioButton
                        android:id="@+id/rbBoy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Boy"
                        android:checked="true"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/open_sans_regular" />

                    <RadioButton
                        android:id="@+id/rbGirl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Girl"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/open_sans_regular" />
                </RadioGroup>

            </LinearLayout>

            <Button
                android:id="@+id/btnCompleteSetup"
                style="@style/OkButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_24dp"
                android:text="Complete Setup" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
