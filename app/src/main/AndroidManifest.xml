<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GET_TASKS" /> <!-- FOR FOREGROUND APPS BEFORE LOLLIPOP -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <!-- NSFW Detection & Foreground Service Permissions (Required for targetSdk 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />


    <application
        android:name=".NotificationChannelCreator"
        android:allowBackup="true"
        android:icon="@drawable/aegistnetlogo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/aegistnetlogo"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar">
        <activity android:name=".activities.AboutActivity"/>
        <activity android:name=".activities.SettingsActivity" />
        <activity android:name=".activities.AccountVerificationActivity" />
        <activity
            android:name=".activities.ChildCredentialActivity"
            android:theme="@style/ChildCredentialTheme" />
        <activity android:name=".activities.ModeSelectionActivity" />
        <activity android:name=".activities.PermissionsActivity" />
        <activity android:name=".activities.BlockedAppActivity" />
        <activity android:name=".activities.BlockedWebActivity" />
        <activity
            android:name=".activities.ChildDetailsActivity"
            android:parentActivityName=".activities.ParentSignedInActivity" />
        <activity android:name=".activities.ChildSignedInActivity" />
        <activity android:name=".activities.ParentSignedInActivity" />
        <activity
            android:name=".activities.SignUpActivity"
            android:parentActivityName=".activities.LoginActivity" />
        <activity android:name=".activities.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Force ZXing QR scanner to stay in portrait -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <service
            android:name=".services.UploadAppsService"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service 
            android:name=".services.MainForegroundService"
            android:foregroundServiceType="dataSync" />
        <service 
            android:name=".services.GeoFencingForegroundService" />
        
        <!-- NSFW Detection Service -->
        <service 
            android:name="com.kidsafe.secure.services.ScreenFilterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name="com.kidsafe.secure.services.NsfwAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nsfw_accessibility_service_config" />
        </service>

        <receiver android:name=".broadcasts.BootCompleteReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- HTC / Motorola fast-boot support -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".broadcasts.AdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
